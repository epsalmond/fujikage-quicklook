			<key>QLSupportedContentTypes</key>
			<array>
				<string>com.epsalmond.fujikage.raf</string>
				<string>com.fuji.raw-image</string>
			</array>
			<key>QLThumbnailMinimumDimension</key>
			<integer>16</integer>
